# ──────────────────────────────────────────────
# Pulse R24 Email Publishing Studio — .gitignore
# ──────────────────────────────────────────────

# ── Python ──
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg
.venv/
venv/
env/
*.whl

# ── Node / Frontend ──
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# ── IDE ──
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Environment ──
.env
.env.local
.env.*.local
backend/.env

# ── Uploads & Output ──
backend/uploads/
backend/output/
*.tmp

# ── Testing ──
.coverage
htmlcov/
.pytest_cache/

# ── OS ──
desktop.ini
ehthumbs.db

# ── Logs ──
*.log
npm-debug.log*

# ── uv ──
uv.lock
